{
  "name": "@alter-ai/gmail-mcp",
  "version": "0.1.0",
  "description": "Gmail MCP server where the agent never holds a Google token: search, read, draft and send, with sends held for human approval and every call audited, backed by Alter.",
  "license": "MIT",
  "author": "Alter AI <oss@alterauth.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlterAIDev/alter-mcp-servers.git",
    "directory": "packages/gmail-mcp"
  },
  "homepage": "https://github.com/AlterAIDev/alter-mcp-servers/tree/main/packages/gmail-mcp#readme",
  "bugs": {
    "url": "https://github.com/AlterAIDev/alter-mcp-servers/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "alter-gmail-mcp": "./dist/index.js"
  },
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/tests/",
    "clean": "rm -rf dist dist-test",
    "prepublishOnly": "pnpm run clean && pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "dependencies": {
    "@alter-ai/alter-sdk": "^0.34.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.6"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "gmail",
    "gmail-mcp",
    "email",
    "ai-agents",
    "human-in-the-loop",
    "alter"
  ]
}
